{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure Clang Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "x64-clang-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build: Clang Debug (All)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/out/build/x64-clang-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build: Clang Debug (Stochastic)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/out/build/x64-clang-debug",
                "--target",
                "OpenGL_OIT_Stochastic_Transparency"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build: Clang Debug (Depth Peeling)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/out/build/x64-clang-debug",
                "--target",
                "OpenGL_OIT_Depth_Peeling"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": "$gcc"
        }
    ]
}
